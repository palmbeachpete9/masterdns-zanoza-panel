[Unit]
Description=Zanoza Panel (MasterDnsVPN manager)
Documentation=https://github.com/palmbeachpete9/masterdns-zanoza-panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run unprivileged: the panel and the MasterDnsVPN child it spawns both run as
# the dedicated `zanoza` user (created by the installer). The child still binds
# UDP :53 via the inherited ambient CAP_NET_BIND_SERVICE — no root (R-09/F26).
User=zanoza
Group=zanoza
Environment=ZANOZA_MASTERDNS_BIN=/usr/local/bin/masterdns-server
ExecStart=/usr/local/bin/zanoza-panel -config /etc/zanoza-panel/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=15s

# ---------------------------------------------------------------------------
# Hardening. CAP_NET_BIND_SERVICE is the ONLY capability granted (low-port bind
# for :53); everything else is dropped, and the writable surface is restricted
# to the panel's own state directory.
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ReadWritePaths=/etc/zanoza-panel
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
