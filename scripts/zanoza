#!/usr/bin/env bash
# ==============================================================================
# zanoza — management CLI for Zanoza Panel (x-ui style menu + direct commands).
#   zanoza            interactive menu
#   zanoza restart    restart the panel service
#   zanoza uninstall  remove the panel
#   zanoza --help     short help
# ==============================================================================
set -euo pipefail

CONFIG_DIR="/etc/zanoza-panel"
CONFIG_PATH="$CONFIG_DIR/config.json"
TLS_CERT="$CONFIG_DIR/tls.crt"
SRC_DIR="/opt/masterdns-zanoza-panel"
SERVICE="zanoza-panel"
PANEL_BIN="/usr/local/bin/zanoza-panel"
SVC_USER="${ZANOZA_SVC_USER:-zanoza}"

# as_svc runs a command as the unprivileged service account, so root never
# writes (or follows symlinks into) service-owned files in $CONFIG_DIR. This
# both preserves file ownership and removes the root-follows-service-symlink
# privilege-escalation primitive (V4-01/V4-02).
as_svc(){
	if id -u "$SVC_USER" >/dev/null 2>&1; then
		runuser -u "$SVC_USER" -- "$@"
	else
		"$@"  # SVC_USER missing (e.g. dev box): run directly
	fi
}

# valid_port / norm_path mirror the backend's validation (F14).
valid_port(){ case "$1" in ''|*[!0-9]*) return 1;; esac; [ "$1" -ge 1 ] && [ "$1" -le 65535 ] || return 1; printf '%s' "$1"; }
norm_path(){
	local p="$1"; [ -n "$p" ] || return 1
	[ "${p#/}" = "$p" ] && p="/$p"
	p="/$(printf '%s' "$p" | sed 's#^/*##; s#/*$##')"
	[ "$p" = "/" ] && return 1
	# Single segment of a safe slug only: rejects spaces, tabs, newlines,
	# control characters, query/fragment and nested slashes (R-07).
	case "${p#/}" in *[!A-Za-z0-9_-]*) return 1;; esac
	printf '%s' "$p"
}

c_g(){ printf '\033[1;32m%s\033[0m\n' "$*"; }
c_y(){ printf '\033[1;33m%s\033[0m\n' "$*"; }
c_r(){ printf '\033[1;31m%s\033[0m\n' "$*"; }
need_root(){ [ "$(id -u)" -eq 0 ] || { c_r "запустите от root (sudo zanoza)"; exit 1; }; }

jget(){ python3 -c "import json,sys; print(json.load(open('$CONFIG_PATH')).get('$1',''))" 2>/dev/null || true; }
jset(){ as_svc python3 - "$1" "$2" <<'PY'
import json,sys,os,tempfile
k,v=sys.argv[1],sys.argv[2]
p="/etc/zanoza-panel/config.json"
c=json.load(open(p))
if k=="panel_port": v=int(v)
c[k]=v
# Atomic write: temp file in the same dir, then rename — never truncate the
# live config on interruption (R-07).
d=os.path.dirname(p) or "."
fd,tmp=tempfile.mkstemp(dir=d)
try:
    with os.fdopen(fd,"w") as f:
        json.dump(c,f,indent=2,ensure_ascii=False)
    os.chmod(tmp,0o600)
    os.replace(tmp,p)
except Exception:
    try: os.unlink(tmp)
    except OSError: pass
    raise
PY
}

panel_url(){
	local port path host scheme="http"
	port="$(jget panel_port)"; path="$(jget panel_path)"
	[ -f "$TLS_CERT" ] && [ -n "$(jget tls_cert)" ] && scheme="https"
	if [ "$(jget panel_addr)" = "127.0.0.1" ]; then host="127.0.0.1"; else host="$(hostname -I 2>/dev/null | awk '{print $1}')"; fi
	printf '%s://%s:%s%s\n' "$scheme" "$host" "$port" "$path"
}

# `|| true` swallows the SIGPIPE (141) `tr` gets when `head` closes the pipe,
# which would otherwise abort the script under `set -o pipefail`.
random_alnum(){ LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c "$1" || true; }

cmd_help(){
cat <<EOF
zanoza — управление панелью Zanoza (MasterDnsVPN).

Команды:
  zanoza                 интерактивное меню
  zanoza restart         перезапустить панель
  zanoza stop|start      остановить/запустить панель
  zanoza status          статус сервиса
  zanoza url             показать адрес панели
  zanoza resetcreds      сгенерировать новый логин/пароль
  zanoza uninstall       удалить панель
  zanoza --help          эта справка

Панель слушает на порту/пути из ${CONFIG_PATH}.
Инстансы (домен+ключ) создаются в веб-интерфейсе и копируются как
домен+ключ либо ссылка zanoza:// для приложения Zanoza (iOS).
EOF
}

reset_creds(){
	need_root
	local user pass
	user="$(random_alnum 10)"; pass="$(random_alnum 20)"
	# Hash + persist with bcrypt atomically via the panel binary, AS THE SERVICE
	# USER so panel.env stays service-owned (a root-owned panel.env would be
	# unreadable by the service and reopen setup) (V4-01/V4-02).
	as_svc "$PANEL_BIN" -config "$CONFIG_PATH" -set-credentials -user "$user" -password "$pass" >/dev/null \
		|| { c_r "не удалось задать учётные данные"; return 1; }
	systemctl restart "$SERVICE" 2>/dev/null || true
	if systemctl is-active --quiet "$SERVICE"; then
		c_g "Новые данные доступа (сервис активен):"
	else
		c_y "Учётные данные сохранены, но сервис не активен — проверьте 'zanoza status'."
	fi
	echo "  Логин:  $user"
	echo "  Пароль: $pass"
	echo "  Адрес:  $(panel_url)"
}

# apply_config_change snapshots config.json, applies a key/value, restarts and
# verifies the service, and rolls back the config if the restart fails (R-07).
apply_config_change(){
	local key="$1" val="$2" label="$3"
	# Snapshot + rollback are performed AS THE SERVICE USER so the files stay
	# service-owned and root never follows a service-controlled .bak path (V4-01).
	as_svc cp -f "$CONFIG_PATH" "$CONFIG_PATH.bak"
	jset "$key" "$val"
	if systemctl restart "$SERVICE" && systemctl is-active --quiet "$SERVICE"; then
		as_svc rm -f "$CONFIG_PATH.bak"
		c_g "${label} изменён -> $(panel_url)"
	else
		as_svc mv -f "$CONFIG_PATH.bak" "$CONFIG_PATH"
		systemctl restart "$SERVICE" 2>/dev/null || true
		c_r "перезапуск не удался — изменение откатано."
	fi
}
change_port(){
	need_root
	read -r -p "Новый порт: " p
	if ! p="$(valid_port "$p")"; then c_r "порт должен быть числом 1..65535"; return; fi
	apply_config_change panel_port "$p" "Порт"
}
change_path(){
	need_root
	read -r -p "Новый путь (например /secret): " p
	if ! p="$(norm_path "$p")"; then c_r "недопустимый путь (только буквы/цифры/_/-, один сегмент, не «/»)"; return; fi
	apply_config_change panel_path "$p" "Путь"
}
cert_menu(){
	need_root
	# Certificate-only: this must NEVER mutate credentials, port, path, binaries
	# or source. We only re-issue an existing self-signed certificate; switching
	# certificate MODE (Let's Encrypt / no-TLS) is an explicit reinstall (V4-08).
	if [ -x /usr/local/bin/zanoza-renew-cert ]; then
		/usr/local/bin/zanoza-renew-cert && c_g "Self-signed сертификат перевыпущен."
	else
		c_y "Для этой панели не настроен self-signed сертификат."
		c_y "Смена режима сертификата выполняется отдельной переустановкой:"
		echo "  curl -fsSL .../scripts/install.sh | sudo bash"
	fi
}
uninstall(){
	need_root
	read -r -p "Удалить Zanoza Panel? Инстансы и конфиг будут удалены. [y/N]: " a
	case "$a" in y|Y) ;; *) c_y "отменено"; return;; esac
	systemctl disable --now "$SERVICE" 2>/dev/null || true
	systemctl disable --now zanoza-cert.timer 2>/dev/null || true
	rm -f /etc/systemd/system/zanoza-panel.service /etc/systemd/system/zanoza-cert.service /etc/systemd/system/zanoza-cert.timer
	systemctl daemon-reload 2>/dev/null || true
	rm -f /usr/local/bin/zanoza-panel /usr/local/bin/masterdns-server /usr/local/bin/zanoza-renew-cert
	rm -rf "$CONFIG_DIR" "$SRC_DIR"
	c_g "Zanoza Panel удалена."
	rm -f /usr/local/bin/zanoza
}
update(){
	need_root
	# Run the on-disk installer in non-interactive update mode (preserves config,
	# credentials, port/path/TLS, instances; atomic binary swap with rollback).
	# Never pipe remote code straight into a root shell (F10/F27).
	[ -f "$SRC_DIR/scripts/install.sh" ] || { c_r "исходники не найдены в $SRC_DIR — переустановите панель."; return 1; }
	ZANOZA_MODE=update bash "$SRC_DIR/scripts/install.sh"
}

menu(){
	while true; do
		echo
		c_g "============ Zanoza Panel ============"
		echo "  Сервис: $(systemctl is-active "$SERVICE" 2>/dev/null || echo unknown)   Адрес: $(panel_url)"
		echo "  1) Показать адрес панели"
		echo "  2) Сбросить логин/пароль"
		echo "  3) Изменить порт"
		echo "  4) Изменить путь"
		echo "  5) Сертификат (перевыпуск/настройка)"
		echo "  6) Перезапустить панель"
		echo "  7) Логи панели"
		echo "  8) Статус"
		echo "  9) Обновить панель"
		echo " 10) Удалить панель"
		echo "  0) Выход"
		read -r -p "Выбор: " ch
		case "$ch" in
			1) echo "Адрес: $(panel_url)";;
			2) reset_creds;;
			3) change_port;;
			4) change_path;;
			5) cert_menu;;
			6) need_root; systemctl restart "$SERVICE"; c_g "перезапущено";;
			7) journalctl -u "$SERVICE" -n 100 --no-pager || true;;
			8) systemctl status "$SERVICE" --no-pager || true;;
			9) update;;
			10) uninstall; break;;
			0) break;;
			*) c_r "неизвестный пункт";;
		esac
	done
}

case "${1:-}" in
	"" ) menu;;
	restart) need_root; systemctl restart "$SERVICE"; c_g "перезапущено";;
	stop) need_root; systemctl stop "$SERVICE"; c_g "остановлено";;
	start) need_root; systemctl start "$SERVICE"; c_g "запущено";;
	status) systemctl status "$SERVICE" --no-pager || true;;
	url) panel_url;;
	resetcreds) reset_creds;;
	uninstall) uninstall;;
	update) update;;
	-h|--help|help) cmd_help;;
	*) c_r "неизвестная команда: $1"; echo; cmd_help; exit 1;;
esac
